<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GameAssembliesDir>$(MSBuildProjectDirectory)\..\..\dependencies\probably-stolen\assemblies</GameAssembliesDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="..\Tuck.Mod\Tuck.Mod.csproj" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameAssembliesDir)\Assembly-CSharp.dll" />
    <Reference Include="0Harmony" HintPath="$(GameAssembliesDir)\0Harmony.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameAssembliesDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameAssembliesDir)\UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameAssembliesDir)\UnityEngine.UIModule.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameAssembliesDir)\Unity.TextMeshPro.dll" />
    <Reference Include="DseCecil" HintPath="$(GameAssembliesDir)\DseCecil.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="PackRecordingTests.cs;RecordingFixtures.cs" />
  </ItemGroup>
</Project>
