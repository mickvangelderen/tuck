<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tuck.ProbablyStolenTestModel\Tuck.ProbablyStolenTestModel.csproj" />
  </ItemGroup>

  <!-- Optional differential checks against locally fetched originals; the model itself has no game dependency. -->
  <PropertyGroup>
    <GameAssembliesDir Condition="'$(GameAssembliesDir)' == ''">$(MSBuildThisFileDirectory)..\..\dependencies\probably-stolen\assemblies</GameAssembliesDir>
    <HasGameGeometry Condition="Exists('$(GameAssembliesDir)\Assembly-CSharp.dll') And Exists('$(GameAssembliesDir)\UnityEngine.CoreModule.dll')">true</HasGameGeometry>
    <DefineConstants Condition="'$(HasGameGeometry)' == 'true'">$(DefineConstants);HAS_GAME_GEOMETRY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HasGameGeometry)' == 'true'">
    <Reference Include="Assembly-CSharp" HintPath="$(GameAssembliesDir)\Assembly-CSharp.dll" Aliases="original" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameAssembliesDir)\UnityEngine.CoreModule.dll" Aliases="originalUnity" />
  </ItemGroup>

</Project>
