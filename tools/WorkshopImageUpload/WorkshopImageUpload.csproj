<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
    <!-- Steamworks.NET supplies the managed bindings; this supplies the native SDK. -->
    <PackageReference Include="Facepunch.Steamworks.Dll" Version="1.62.0" />
    <Compile Include="..\WorkshopDescription.cs" Link="WorkshopDescription.cs" />
    <None Update="steam_appid.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
